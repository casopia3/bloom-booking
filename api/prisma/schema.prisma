// Bloom Booking — Phase 1 schema (v2)
// Aligned to the official Phase 1 Development Plan.
// Covers: Standard salon booking + VIP Home Service booking.
// Deferred (not in this schema): wallet/Bloom Coins, e-commerce, ride-hailing,
// gifts/donations, social feed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  SPECIALIST
  PROVIDER_ADMIN // manages one ServiceProvider (salon)
  SUPER_ADMIN    // platform-wide oversight
}

enum BookingType {
  STANDARD   // at the salon
  VIP_HOME   // specialist travels to customer's location
}

enum BookingStatus {
  PENDING             // created, awaiting specialist accept/assign
  CONFIRMED           // specialist accepted
  SPECIALIST_ASSIGNED // provider assigned a specialist (VIP flow, or unassigned standard booking)
  ON_THE_WAY          // VIP only: specialist en route
  IN_PROGRESS         // service actively happening
  COMPLETED
  DECLINED            // specialist declined
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_PROVIDER
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_ASSIGNED
  BOOKING_CANCELLED
  BOOKING_COMPLETED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true) // admin can disable any account regardless of role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  phoneVerified          Boolean   @default(false)
  otpCode                String?
  otpExpiresAt           DateTime?
  passwordResetToken     String?   @unique
  passwordResetExpiresAt DateTime?

  customerProfile   Customer?
  providerAdminOf   ServiceProvider? @relation("ProviderAdmin")
  specialistProfile Specialist?

  notifications Notification[]
}

model Customer {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  name       String
  gender     String?
  occupation String?

  bookings   Booking[]
  reviews    Review[]
  favourites Favourite[]

  createdAt DateTime @default(now())
}

model ServiceProvider {
  id     String @id @default(cuid())
  adminUserId String @unique
  admin  User   @relation("ProviderAdmin", fields: [adminUserId], references: [id])

  businessName String
  about        String?
  address      String
  latitude     Float?
  longitude    Float?

  supportsVipHome   Boolean @default(false)
  vipServiceRadiusKm Float?
  vipTravelFee       Decimal? @db.Decimal(10, 2)

  commissionRate Decimal @default(0) @db.Decimal(5, 2)
  isVerified     Boolean @default(false)
  isEnabled      Boolean @default(true)

  specialists   Specialist[]
  services      Service[]
  bookings      Booking[]
  reviews       Review[]
  availability  Availability[]
  galleryImages ProviderImage[]
  favouritedBy  Favourite[]

  createdAt DateTime @default(now())
}

model ProviderImage {
  id                String          @id @default(cuid())
  serviceProviderId String
  provider          ServiceProvider @relation(fields: [serviceProviderId], references: [id])
  url               String
  createdAt         DateTime        @default(now())
}

model Specialist {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  serviceProviderId String
  provider          ServiceProvider @relation(fields: [serviceProviderId], references: [id])

  name      String
  specialty String
  bio       String?
  photoUrl  String?

  supportsVipHome Boolean @default(false)

  bookings     Booking[]
  reviews      Review[]
  availability Availability[]
  services     SpecialistService[]

  createdAt DateTime @default(now())
}

model Service {
  id                String          @id @default(cuid())
  serviceProviderId String
  provider          ServiceProvider @relation(fields: [serviceProviderId], references: [id])

  name        String
  description String?
  durationMin Int
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  category    String? // [DECISION] free-text for Phase 1 (not an enum) —
                        // matches the mockup's category chips (Spa, Haircut,
                        // Coloring, Manicure) without locking to a fixed list
                        // before the client confirms the real taxonomy.

  availableStandard Boolean @default(true)
  availableVip      Boolean @default(false)

  bookingServices BookingService[]
  specialists     SpecialistService[]

  createdAt DateTime @default(now())
}

model SpecialistService {
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id])
  serviceId    String
  service      Service    @relation(fields: [serviceId], references: [id])

  @@id([specialistId, serviceId])
}

model Availability {
  id String @id @default(cuid())

  serviceProviderId String
  provider          ServiceProvider @relation(fields: [serviceProviderId], references: [id])

  specialistId String?
  specialist   Specialist? @relation(fields: [specialistId], references: [id])

  dayOfWeek   DayOfWeek
  startTime   String
  endTime     String
  slotMinutes Int       @default(30)

  breakStart  String?
  breakEnd    String?
}

model BlockedDate {
  id String @id @default(cuid())

  serviceProviderId String?
  specialistId       String?

  date      DateTime
  startTime String?
  endTime   String?
  reason    String?

  createdAt DateTime @default(now())
}

model Booking {
  id String @id @default(cuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  serviceProviderId String
  provider          ServiceProvider @relation(fields: [serviceProviderId], references: [id])

  specialistId String?
  specialist   Specialist? @relation(fields: [specialistId], references: [id])

  services BookingService[]

  bookingType BookingType @default(STANDARD)
  location    BookingLocation?

  scheduledAt DateTime
  durationMin Int

  servicesSubtotal Decimal  @db.Decimal(10, 2)
  vipTravelFee     Decimal? @db.Decimal(10, 2)
  totalPrice       Decimal  @db.Decimal(10, 2)

  status BookingStatus @default(PENDING)
  note   String?

  cancelledAt        DateTime?
  cancellationReason String?

  payment Payment?
  review  Review?
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceProviderId, scheduledAt])
  @@index([specialistId, scheduledAt])
}

model BookingService {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  priceAtBooking Decimal @db.Decimal(10, 2)

  @@unique([bookingId, serviceId])
}

model BookingLocation {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  address      String
  latitude     Float
  longitude    Float
  instructions String?
}

model Payment {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  amount   Decimal       @db.Decimal(10, 2)
  status   PaymentStatus @default(PENDING)

  // Commission decision (blueprint section J): 0% at launch, field added now
  // so no schema rewrite is needed if/when the client sets a real rate.
  // Still [OPEN] per blueprint summary — needs explicit client confirmation.
  platformFeeAmount Decimal @default(0) @db.Decimal(10, 2)

  chapaTxRef  String?  @unique
  chapaStatus String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Review {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  serviceProviderId String
  provider          ServiceProvider @relation(fields: [serviceProviderId], references: [id])

  specialistId String?
  specialist   Specialist? @relation(fields: [specialistId], references: [id])

  rating   Int
  comment  String?
  photoUrl String?

  createdAt DateTime @default(now())
}

model Favourite {
  id                String          @id @default(cuid())
  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id])
  serviceProviderId String
  serviceProvider   ServiceProvider @relation(fields: [serviceProviderId], references: [id])

  createdAt DateTime @default(now())

  @@unique([customerId, serviceProviderId])
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type    NotificationType
  title   String
  body    String?
  read    Boolean @default(false)

  relatedBookingId String?
  relatedBooking   Booking? @relation(fields: [relatedBookingId], references: [id])

  createdAt DateTime @default(now())
}
