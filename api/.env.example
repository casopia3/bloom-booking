# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bloom_booking?schema=public"

# Redis (slot-locking / concurrency protection)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Payment — CHAPA integration pending final client confirmation
# per project spec: "subject to final confirmation of the client's required payment integration"
CHAPA_SECRET_KEY=""
CHAPA_PUBLIC_KEY=""
CHAPA_WEBHOOK_SECRET=""

# App
PORT=3000
NODE_ENV=development
